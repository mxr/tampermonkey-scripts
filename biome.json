{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": ["**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "globals": [
      "ArrayBuffer",
      "Blob",
      "Event",
      "FormData",
      "MutationObserver",
      "Request",
      "URL",
      "URLSearchParams",
      "XMLHttpRequest",
      "clearInterval",
      "document",
      "globalThis",
      "history",
      "navigator",
      "queueMicrotask",
      "setInterval",
      "window"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error"
      }
    }
  }
}
